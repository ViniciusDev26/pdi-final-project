# Dados locais (dataset do Kaggle e splits gerados)
data/*
!data/.gitkeep

# Arquivo intermediário do gerador do PDF
docs/*.html

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.ipynb_checkpoints/

# Artefatos de treinamento
models/*
!models/.gitkeep
runs/
*.pt
*.pth
*.onnx
*.joblib

# Ambiente / SO
.env
.DS_Store
.idea/
.vscode/

# Saídas dos experimentos: versionadas por cenário (métricas, predições e modelo, este no
# Git LFS); cache do pipeline, fila, estado e log ficam fora
results/*
!results/.gitkeep
!results/[A-Z][0-9]/
results/[A-Z][0-9]/*
!results/[A-Z][0-9]/metrics.json
!results/[A-Z][0-9]/predictions.csv
!results/[A-Z][0-9]/history.csv
!results/[A-Z][0-9]/gradcam.csv
!results/[A-Z][0-9]/resumo.json
!results/[A-Z][0-9]/model.joblib
!results/[A-Z][0-9]/model.pt
